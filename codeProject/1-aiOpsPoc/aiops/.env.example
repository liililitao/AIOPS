# ==========================================
# AIOps Alert Agent - 配置文件
# 复制此文件为 .env 并填入实际值
# ==========================================

# ==========================================
# 应用基础配置
# ==========================================
APP_NAME=AIOps-Alert-Agent
APP_VERSION=1.0.0
DEBUG=false
PORT=8001
HOST=0.0.0.0

# ==========================================
# LLM API 配置 (OpenAI-compatible)
# ==========================================
LLM_BASE_URL=https://api.marketplace.novo-genai.com/v1
LLM_API_KEY=your-api-key-here
LLM_USER_EMAIL=your-email@example.com

# 模型配置 (可用的模型名称，根据实际API调整)
ROUTER_MODEL=openai_gpt5
PLANNER_MODEL=openai_gpt5
EXECUTOR_MODEL=openai_gpt5
REPORT_MODEL=openai_gpt5
RAG_CHAT_MODEL=openai_gpt5

# LLM 参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ==========================================
# 定时扫描配置
# ==========================================
SCAN_ENABLED=true
SCAN_INTERVAL_MINUTES=5
ALERT_INPUT_DIR=../mutil-rag-agent-main-v1/告警数据
ALERT_OUTPUT_DIR=../mutil-rag-agent-main-v1/带风险等级的告警数据
PROCESSED_INDEX_PATH=data/processed_alerts.json

# ==========================================
# Splunk 真实告警数据源
# ==========================================
# 为专用只读账号生成可用于 "Authorization: Splunk <凭据>" 的 REST sessionKey
# 或认证 Token 后填入。不要使用 HTTP Event Collector（HEC）Token。
# 生产环境请将真实凭据保存为系统环境变量或密钥管理服务，不要提交 .env。
SPLUNK_ENABLED=false
SPLUNK_BASE_URL=https://splunk.example.com:8089
SPLUNK_TOKEN=replace-with-a-search-only-splunk-token
SPLUNK_VERIFY_TLS=true
SPLUNK_ALERT_INDEX=waflogalert
# 留空时查询 "index=waflogalert"；也可以填写完整 SPL，例如：
# SPLUNK_ALERT_QUERY=search index=waflogalert | sort 0 - _time | head 500
SPLUNK_ALERT_QUERY=
SPLUNK_ALERT_EARLIEST_TIME=-24h@h
SPLUNK_ALERT_LATEST_TIME=now
SPLUNK_ALERT_MAX_RESULTS=500
SPLUNK_TIMEOUT_SECONDS=20
# Agent 的第三个 Tool：仅执行服务端预置的只读日志调查模板。
# 与告警同步共用 search-only Token；未配置时 Agent 会记录“无可用 Splunk 证据”，
# 但仍会继续历史告警、知识库/CMDB、报告和建议流程。
SPLUNK_LOG_INDEX=azure
SPLUNK_INVESTIGATION_MAX_RESULTS=200
SPLUNK_INVESTIGATION_MAX_ITEMS=10
SPLUNK_INVESTIGATION_MAX_TEXT_CHARS=160
SPLUNK_INVESTIGATION_ITEM_BUDGET_CHARS=4000
SPLUNK_INVESTIGATION_TOTAL_BUDGET_CHARS=12000

# ==========================================
# Splunk 跳转认证与告警权限
# ==========================================
# 仅当以下两个 Secret 都已安全配置后才设置为 true。
# AIOPS_HANDOFF_SECRET 必须与 Splunk aiops_handoff/local/hmac_secret 内容完全相同。
# AIOPS_SESSION_SECRET 是本服务独有的至少 32 字符随机密钥。
AIOPS_AUTH_ENABLED=false
AIOPS_HANDOFF_SECRET=
AIOPS_SESSION_SECRET=
AIOPS_HANDOFF_MAX_TTL_SECONDS=120
AIOPS_HANDOFF_CLOCK_SKEW_SECONDS=5
AIOPS_HANDOFF_NONCE_DB=data/handoff_nonces.sqlite3
AIOPS_SESSION_HOURS=8
AIOPS_COOKIE_SECURE=false
# 留空将使用 ../gateway/data/aiops_authorization.sqlite3
AIOPS_AUTHZ_DB=

# ==========================================
# CMDB 数据源配置
# ==========================================
CMDB_TYPE=xlsx
CMDB_XLSX_PATH=../CMDB数据库/NNSH CIOA_Service_Azure__monthly_summary -V2.70-20260601.xlsx
CMDB_CSV_PATH=data/cmdb_latest.csv
# 选择 splunk_csv 时启用每日 CMDB CSV 导入
CMDB_SPLUNK_QUERY=
CMDB_SPLUNK_SYNC_ENABLED=false
CMDB_SPLUNK_SYNC_HOUR=1
CMDB_SPLUNK_SYNC_MINUTE=0
# CMDB_API_URL=                    # 未来 API 模式时启用
# CMDB_API_TOKEN=                  # 未来 API 模式时启用

# ==========================================
# 风险判定参数（可后期调整）
# ==========================================
RISK_COUNT_HIGH_THRESHOLD=200
RISK_COUNT_MEDIUM_THRESHOLD=100

# ==========================================
# Milvus 向量数据库（运维手册 RAG）
# ==========================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=sop_knowledge
MILVUS_ENABLED=false

# 告警分类库与未命中时的 RAG
# 分类库命中后直接复用历史报告和建议；未命中后生成结果会自动入库。
SEMANTIC_MATCH_THRESHOLD=85
ALERT_CLASSIFICATION_ENABLED=true
ALERT_CLASSIFICATION_AUTO_ENROLL=true
ALERT_CLASSIFICATION_MAX_CANDIDATES=12
ALERT_CLASSIFICATION_MAX_FIELD_CHARS=800
OUTPUT_AGENT_RUNS_DIR=output/agent_runs
ALERT_RAG_ENABLED=true
ALERT_RAG_TOP_K=3
ALERT_RAG_MAX_CONTEXT_CHARS=5000

# Embedding 配置
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.marketplace.novo-genai.com/v1
EMBEDDING_API_KEY=your-api-key-here

# ==========================================
# 输出配置
# ==========================================
OUTPUT_REPORTS_DIR=output/reports
OUTPUT_SUGGESTIONS_DIR=output/suggestions

# ==========================================
# Web 服务配置
# ==========================================
FRONTEND_DIR=frontend
CORS_ORIGINS=*

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=logs
