<dashboard version="1.1" theme="light">
  <label>WAF 告警监控</label>
  <description>
    Azure WAF Blocked 事件告警监控面板
    数据来源: index=waflogalert 
  </description>

  <!-- 由 Splunk 服务端每 30 秒刷新一次短时 HMAC 签名链接 -->
  <search id="aiops_handoff_link_search">
    <query>| makeresults | aiopssignurl</query>
    <refresh>30s</refresh>
    <refreshType>delay</refreshType>
    <done>
      <set token="aiops_handoff_url">$result.handoff_url$</set>
    </done>
  </search>

  <!-- ===== 第一行: KPI 统计卡片 ===== -->
  <row>
    <panel>
      <single>
        <title>总告警数 (24h)</title>
        <search>
          <query>index=waflogalert | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>🔴 高风险</title>
        <search>
          <query>index=waflogalert risk_level="高" | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>🟡 中风险</title>
        <search>
          <query>index=waflogalert risk_level="中" | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>🟢 低风险</title>
        <search>
          <query>index=waflogalert risk_level="低" | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <!-- ===== 第二行: 告警时间趋势 ===== -->
  <row>
    <panel>
      <chart>
        <title>告警触发趋势 (按风险等级)</title>
        <search>
          <query>
            index=waflogalert
            | rex field=trigger_time "(?&lt;ts&gt;[^\.\+]+)"
            | eval _time = strptime(ts, "%Y-%m-%dT%H:%M:%S")
            | timechart span=1h count by risk_level
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.fieldColors">{"高":0xDC3545, "中":0xFFC107, "低":0x28A745}</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>

  <!-- ===== 第三行: 风险分布 + 最近告警列表 ===== -->
  <row>
    <panel>
      <chart>
        <title>风险等级分布</title>
        <search>
          <query>index=waflogalert | stats count by risk_level</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.fieldColors">{"高":0xDC3545, "中":0xFFC107, "低":0x28A745}</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>最近告警记录</title>
        <search>
          <query>
            index=waflogalert
            | rex field=trigger_time "(?&lt;ts&gt;[^\.\+]+)"
            | eval _time = strptime(ts, "%Y-%m-%dT%H:%M:%S")
            | sort - _time
            | table _time, alert_name, event_count, risk_level, trigger_reason
            | rename _time as "触发时间", alert_name as "告警名称",
              event_count as "命中数", risk_level as "风险等级",
              trigger_reason as "触发原因"
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <!-- ===== 第四行: 原始 WAF 日志分析 (index=azure) ===== -->
  <row>
    <panel>
      <chart>
        <title>Blocked 请求趋势</title>
        <search>
          <query>
            index=azure category=ApplicationGatewayFirewallLog properties_action=Blocked
            | timechart span=30m count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.seriesColors">0xDC3545</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <chart>
        <title>被攻击 Hostname Top 5</title>
        <search>
          <query>
            index=azure category=ApplicationGatewayFirewallLog properties_action=Blocked
            | top limit=5 properties_hostname
            | sort - count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.chart.stackMode">default</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>攻击来源 IP Top 10</title>
        <search>
          <query>
            index=azure category=ApplicationGatewayFirewallLog properties_action=Blocked
            | top limit=10 properties_clientIp
            | sort - count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <table>
        <title>被攻击 URI Top 20</title>
        <search>
          <query>
            index=azure category=ApplicationGatewayFirewallLog properties_action=Blocked
            | top limit=20 properties_requestUri showperc=f
            | sort - count
            | rename properties_requestUri as "请求URI", count as "Blocked次数",
              percent as "占比"
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <!-- ===== 第七行: AIOps 诊断平台入口 ===== -->
  <row>
    <panel depends="$aiops_handoff_url$">
      <html>
        <a href="$aiops_handoff_url$"
           target="_blank"
           style="display:inline-block; padding:8px 20px; background-color:#1e93c6; color:white; text-decoration:none; border-radius:4px;">
          进入 AIOps 诊断平台
        </a>
      </html>
    </panel>
    <panel rejects="$aiops_handoff_url$">
      <html>
        <p>正在生成 AIOps 安全入口，请稍候…</p>
      </html>
    </panel>
  </row>
</dashboard>
