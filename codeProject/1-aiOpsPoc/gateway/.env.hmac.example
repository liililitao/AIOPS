# Keep the two secret files different and chmod 600 on Linux.
AIOPS_HANDOFF_SECRET_FILE=/opt/aiops-gateway/secrets/handoff_secret
JWT_SECRET_FILE=/opt/aiops-gateway/secrets/jwt_secret

AIOPS_HANDOFF_MAX_TTL_SECONDS=120
AIOPS_HANDOFF_CLOCK_SKEW_SECONDS=5
AIOPS_HANDOFF_NONCE_DB=/var/lib/aiops-gateway/handoff_nonces.sqlite3

# Empty means every authenticated Splunk role is allowed.
# Example: AIOPS_ALLOWED_ROLES=admin,power
AIOPS_ALLOWED_ROLES=

ALLOW_LEGACY_SPLUNK_USER=false
ALLOW_SPLUNK_TOKEN_QUERY=false

# Keep false only while the site is HTTP. Set true after enabling HTTPS.
AUTH_COOKIE_SECURE=false
FLASK_DEBUG=false

SPLUNK_HOST=127.0.0.1
SPLUNK_PORT=8089
SPLUNK_WEB_URL=http://spl9-tst-hfwr01.chinanorth3.cloudapp.chinacloudapi.cn:8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
